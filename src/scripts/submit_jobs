#!/bin/bash
#SBATCH -J keystroke_train
#SBATCH -p gpu                 # GPU partition (7 days)
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:4
#SBATCH -t 7-00:00:00
#SBATCH -o logs/job-%j.out
#SBATCH -e logs/job-%j.err

# cd to repo root regardless of where sbatch was run from
# script lives at <repo>/src/scripts/submit_jobs, so go up two levels
cd "$(dirname "$(realpath "$0")")/../.."
mkdir -p logs

# --- env setup ---
module purge
module load anaconda           # or module load python/3.11 if that’s how your site does it
source ~/.bashrc
conda activate keystroke       # <-- set to your conda env name

# (optional) CUDA module, only if required on your site:
# module load cuda

# sanity
echo "PYTHON: $(which python)"
python -c "import torch; print('torch', torch.__version__, 'cuda?', torch.cuda.is_available())"
nvidia-smi

# PyTorch/HF niceties
export PYTHONPATH="src:$PYTHONPATH"
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=$(nproc)
export TORCH_USE_CUDA_DSA=1
# CUDA_LAUNCH_BLOCKING=1  # Only enable for debugging
# CUDA_VISIBLE_DEVICES=0  # Only enable for debugging

#python -m Trainer.Trainer
#python -m Testing.synthesizeKeystrokes
python -m Testing.accuracyTester
